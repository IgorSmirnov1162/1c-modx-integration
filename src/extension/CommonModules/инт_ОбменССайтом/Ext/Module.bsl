///////////////////////////////////////////////////////////////////
// Общий модуль инт_ОбменССайтом
// Цикл обмена по протоколу CommerceML 2.0:
// checkauth → init → query → загрузка → success

// ---------- Работа с безопасным хранилищем ----------

Процедура СохранитьПароль(СсылкаНастроек, Пароль) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СсылкаНастроек) Тогда
		ВызватьИсключение "Сначала запишите элемент справочника настроек";
	КонецЕсли;
	
	ОбъектНастроек = СсылкаНастроек.ПолучитьОбъект();
	ОбъектНастроек.ПарольХранилище = Новый ХранилищеЗначения(Пароль);
	ОбъектНастроек.Записать();
	
КонецПроцедуры

Функция ПолучитьПароль(СсылкаНастроек)
	
	Хранимое = СсылкаНастроек.ПарольХранилище;
	Если НЕ ЗначениеЗаполнено(Хранимое) Тогда
		ВызватьИсключение "Пароль не сохранён. Откройте элемент настроек и сохраните пароль.";
	КонецЕсли;
	
	Пароль = Хранимое.Получить();
	Если НЕ ЗначениеЗаполнено(Пароль) Тогда
		ВызватьИсключение "Пароль пустой — сохраните его заново.";
	КонецЕсли;
	
	Возврат Пароль;
	
КонецФункции

// ---------- Основной цикл обмена ----------

Функция ВыполнитьЦиклОбмена(СсылкаНастроек) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СсылкаНастроек) Тогда
		СсылкаНастроек = ПолучитьАктивныеНастройки();
	КонецЕсли;
	
	Пароль = ПолучитьПароль(СсылкаНастроек);
	
	// Сводная структура настроек: используется и HTTP-запросами,
	// и загрузчиком заказов (ОбработатьЗаказ)
	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервера",   СсылкаНастроек.АдресСервера);
	Настройки.Вставить("ПутьСкрипта",    СсылкаНастроек.ПутьСкрипта);
	Настройки.Вставить("Логин",          СсылкаНастроек.Логин);
	Настройки.Вставить("Пароль",         Пароль);
	Настройки.Вставить("СтатусОтправлен", СсылкаНастроек.СтатусОтправлен);
	Настройки.Вставить("Организация",    СсылкаНастроек.Организация);
	Настройки.Вставить("Склад",          СсылкаНастроек.Склад);
	
	// 1. checkauth — получаем cookie сессии обмена
	Ответ = ОтправитьЗапрос(Настройки, "type=sale&mode=checkauth", "");
	Части = СтрРазделить(Ответ, Символы.ПС, Ложь);
	Если Части.Количество() < 3 Или СокрЛП(Части[0]) <> "success" Тогда
		ВызватьИсключение "checkauth не прошёл: " + Ответ;
	КонецЕсли;
	Cookie = СокрЛП(Части[1]) + "=" + СокрЛП(Части[2]);
	
	// 2. init
	Ответ = ОтправитьЗапрос(Настройки, "type=sale&mode=init", Cookie);
	Если СтрНайти(Ответ, "zip=no") = 0 Тогда
		ВызватьИсключение "Сайт требует zip — отключите сжатие на стороне сайта";
	КонецЕсли;
	
	// 3. query — забираем заказы
	XMLЗаказы = ОтправитьЗапрос(Настройки, "type=sale&mode=query", Cookie);
	
	Если ПустаяСтрока(XMLЗаказы) Или СтрНайти(XMLЗаказы, "<Документ>") = 0 Тогда
		инт_ЗагрузкаЗаказов.ЗаписатьВЖурнал("Обмен", "Новых заказов нет", Истина);
		Возврат "Новых заказов нет";
	КонецЕсли;
	
	Заказы = инт_ПарсерCommerceML.ПрочитатьЗаказы(XMLЗаказы);
	
	Обработано = 0;
	Для Каждого Заказ Из Заказы Цикл
		инт_ЗагрузкаЗаказов.ОбработатьЗаказ(Заказ, Настройки);
		Обработано = Обработано + 1;
	КонецЦикла;
	
	// 4. success — только если всё прошло без ошибок
	Ответ = ОтправитьЗапрос(Настройки, "type=sale&mode=success", Cookie);
	Если СтрНайти(Ответ, "success") = 0 Тогда
		ВызватьИсключение "Сайт не подтвердил success: " + Ответ;
	КонецЕсли;
	
	Отчёт = "Обработано заказов: " + Обработано;
	инт_ЗагрузкаЗаказов.ЗаписатьВЖурнал("Обмен", Отчёт, Истина);
	Возврат Отчёт;
	
КонецФункции

// ---------- Служебные ----------

Функция ПолучитьАктивныеНастройки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.инт_НастройкиОбмена КАК Настройки
		|ГДЕ
		|	Настройки.Активен";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьИсключение "Нет активной записи в справочнике инт_НастройкиОбмена";
	
КонецФункции

Функция ОтправитьЗапрос(Настройки, ПараметрыURL, Cookie)
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Соединение = Новый HTTPСоединение(
		Настройки.АдресСервера,,, , , 30, ЗащищенноеСоединение);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Basic " + Base64Строка(
		ПолучитьДвоичныеДанныеИзСтроки(Настройки.Логин + ":" + Настройки.Пароль)));
	Если ЗначениеЗаполнено(Cookie) Тогда
		Заголовки.Вставить("Cookie", Cookie);
	КонецЕсли;
	
	Запрос = Новый HTTPЗапрос(Настройки.ПутьСкрипта + "?" + ПараметрыURL, Заголовки);
	Ответ = Соединение.Получить(Запрос);
	
	Если Ответ.КодСостояния >= 400 Тогда
		ВызватьИсключение СтрШаблон("HTTP %1: %2",
			Ответ.КодСостояния, Лев(Ответ.ПолучитьТелоКакСтроку(), 500));
	КонецЕсли;
	
	Возврат Ответ.ПолучитьТелоКакСтроку();
	
КонецФункции



