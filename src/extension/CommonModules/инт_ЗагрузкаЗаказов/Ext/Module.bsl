//////////////////////////////////////////////////
// Загрузка заказов с сайта (miniShop2, CommerceML)
// Модуль: инт_ЗагрузкаЗаказов (Сервер)
//////////////////////////////////////////////////

Процедура ОбработатьЗаказ(ДанныеЗаказа, Настройка) Экспорт
	
	// Сначала всегда грузим заказ, если связи ещё нет
	Связь = НайтиСвязьЗаказа(ДанныеЗаказа.Ид);
	
	Если Связь = Неопределено Тогда
		СоздатьДокументЗаказа(ДанныеЗаказа, Настройка);
		Связь = НайтиСвязьЗаказа(ДанныеЗаказа.Ид);
	КонецЕсли;
	
	Если Связь = Неопределено Тогда
		ЗаписатьВЖурнал("Обмен", "Заказ " + ДанныеЗаказа.Ид
			+ ": не удалось создать документ и связь", Ложь);
		Возврат;
	КонецЕсли;
	
	// Статус влияет только на создание реализации
	СтатусЗаказа    = НРег(СокрЛП(ДанныеЗаказа.СтатусЗаказа));
	СтатусОтправлен = НРег(СокрЛП(Настройка.СтатусОтправлен));
	
	Если ПустаяСтрока(СтатусОтправлен) Тогда
		ЗаписатьВЖурнал("Обмен", "Не заполнен СтатусОтправлен в настройках: заказ "
			+ ДанныеЗаказа.Ид + " загружен, реализация не создана (статус сайта: '"
			+ СтатусЗаказа + "')", Ложь);
		Возврат;
	КонецЕсли;
	
	Если СтатусЗаказа = СтатусОтправлен Тогда
		
		Если НЕ ЗначениеЗаполнено(Связь.Реализация) Тогда
			СсылкаРеализации = СоздатьРеализацию(ДанныеЗаказа, Связь.Документ1С, Настройка);
			ЗаписатьРеализациюВСвязь(ДанныеЗаказа.Ид, СсылкаРеализации);
			ЗаписатьВЖурнал("Обмен", "Создана реализация по заказу Ид " + ДанныеЗаказа.Ид
				+ ": " + Строка(СсылкаРеализации), Истина);
		КонецЕсли;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Связь.Реализация) Тогда
		// Диагностика: покажет, что сайт реально шлёт в поле статуса
		ЗаписатьВЖурнал("Обмен", "Заказ " + ДанныеЗаказа.Ид + ", статус сайта '"
			+ СтатусЗаказа + "' не совпал с настройкой '" + СтатусОтправлен + "'", Истина);
	КонецЕсли;
	
КонецПроцедуры


Процедура СоздатьДокументЗаказа(ДанныеЗаказа, Настройка) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Контрагент = НайтиИлиСоздатьКонтрагента(ДанныеЗаказа.Контрагент);
		
		Заказ = Документы.инт_ЗаказССайта.СоздатьДокумент();
		Заказ.Дата = ТекущаяДатаСеанса();
		Заказ.ДатаЗаказа = ВДату(ДанныеЗаказа.Дата, ДанныеЗаказа.Время);
		Заказ.Организация = Настройка.Организация; // из настройки, а не «первая в базе»
		Заказ.Контрагент = Контрагент;
		Заказ.ВнешнийИд = ДанныеЗаказа.Ид;
		Заказ.СтатусСайта = ДанныеЗаказа.СтатусЗаказа;
		Заказ.Комментарий = "С сайта miniShop2, Ид=" + ДанныеЗаказа.Ид
			+ ", получатель: " + ДанныеЗаказа.Контрагент.Наименование;
		
		Для Каждого Строка Из ДанныеЗаказа.Товары Цикл
			Стр = Заказ.Товары.Добавить();
			Стр.Номенклатура = НайтиИлиСоздатьНоменклатуру(Строка.Наименование, Строка.Артикул);
			Стр.Количество = Строка.Количество;
			Стр.Цена = Строка.ЦенаЗаЕдиницу;
			Стр.Сумма = Строка.Количество * Строка.ЦенаЗаЕдиницу;
		КонецЦикла;
		
		Заказ.Записать(); // документ непроводимый, проверок не требует
		
		Набор = РегистрыСведений.инт_СвязьЗаказов.СоздатьНаборЗаписей();
		Запись = Набор.Добавить();
		Запись.ВнешнийИд = ДанныеЗаказа.Ид;
		Запись.Документ1С = Заказ.Ссылка;
		Запись.ДатаЗагрузки = ТекущаяДатаСеанса();
		Набор.Отбор.ВнешнийИд.Установить(ДанныеЗаказа.Ид);
		Набор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ЗаписатьВЖурнал("Ошибка заказа " + ДанныеЗаказа.Ид, ОписаниеОшибки(), Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция СоздатьРеализацию(ДанныеЗаказа, ЗаказССайта, Настройка)
	
	Реализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Реализация.Дата = ТекущаяДатаСеанса();
	Реализация.Организация = Настройка.Организация;
	Реализация.Контрагент = ЗаказССайта.Контрагент;
	Реализация.ДоговорКонтрагента = НайтиИлиСоздатьДоговор(ЗаказССайта.Контрагент);
	Реализация.Комментарий = "Создана автоматически по заказу с сайта, Ид " + ДанныеЗаказа.Ид;
	
	Если ЗначениеЗаполнено(Настройка.Склад) Тогда
		Реализация.Склад = Настройка.Склад;
	КонецЕсли;
	
	// Зачёт аванса — если реквизит есть в этой редакции БП
	Если Реализация.Метаданные().Реквизиты.Найти("ЗачетАванса") <> Неопределено Тогда
		Реализация.ЗачетАванса = Перечисления.ВариантыЗачетаАванса.Автоматически;
	КонецЕсли;
	
	Для Каждого СтрокаСайта Из ДанныеЗаказа.Товары Цикл
		
		Строка = Реализация.Товары.Добавить();
		Строка.Номенклатура = НайтиИлиСоздатьНоменклатуру(
			СтрокаСайта.Наименование, СтрокаСайта.Артикул);
		Строка.Количество = СтрокаСайта.Количество;
		Строка.Цена       = СтрокаСайта.ЦенаЗаЕдиницу;
		Строка.Сумма      = Строка.Количество * СтрокаСайта.ЦенаЗаЕдиницу;
		Строка.СтавкаНДС  = СтавкаНДСПоУмолчанию();
		
	КонецЦикла;
	
	Реализация.Записать(РежимЗаписиДокумента.Запись);
	
	// Проведение: если не удалось (не хватило счетов учёта, остатков и т. п.) —
	// документ остаётся записанным непроведённым, его дооформят вручную.
	// Обмен при этом не падает: ссылка возвращается как обычно.
	Попытка
		Реализация.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаписатьВЖурнал("Обмен", "Реализация по заказу Ид " + ДанныеЗаказа.Ид
			+ " записана, но НЕ проведена: " + ОписаниеОшибки(), Ложь);
	КонецПопытки;
	
	Возврат Реализация.Ссылка;
	
КонецФункции

Процедура ЗаписатьРеализациюВСвязь(Знач ВнешнийИд, Знач Реализация)
	
	Набор = РегистрыСведений.инт_СвязьЗаказов.СоздатьНаборЗаписей();
	Набор.Отбор.ВнешнийИд.Установить(ВнешнийИд);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Набор[0].Реализация = Реализация;
	Набор.Записать();
	
КонецПроцедуры

Функция НайтиСвязьЗаказа(Знач ВнешнийИд)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Связь.Документ1С КАК Документ1С,
	|	Связь.Реализация КАК Реализация
	|ИЗ
	|	РегистрСведений.инт_СвязьЗаказов КАК Связь
	|ГДЕ
	|	Связь.ВнешнийИд = &ВнешнийИд";
	Запрос.УстановитьПараметр("ВнешнийИд", ВнешнийИд);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Функция НайтиИлиСоздатьКонтрагента(ДанныеКонтрагента)
	
	Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(СокрЛП(ДанныеКонтрагента.Наименование), Истина);
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Контрагент;
	КонецЕсли;
	
	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Наименование = СокрЛП(ДанныеКонтрагента.Наименование);
	// В свежих редакциях БП 3.0 реквизит обязателен; если в текущей его нет — удалить строку ниже
	Контрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	Контрагент.Записать();
	
	Возврат Контрагент.Ссылка;
	
КонецФункции

Функция НайтиИлиСоздатьНоменклатуру(Наименование, Артикул)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул = &Артикул
		|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Артикул));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовыйТовар = Справочники.Номенклатура.СоздатьЭлемент();
	НовыйТовар.Наименование = Наименование;
	НовыйТовар.Артикул = СокрЛП(Артикул);
	НовыйТовар.Записать();
	
	Возврат НовыйТовар.Ссылка;
	
КонецФункции

Функция НайтиИлиСоздатьДоговор(Контрагент)
	
	// Ищем любой договор вида «С покупателем»
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент
	|	И Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// Не нашли — создаём
	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Владелец     = Контрагент;
	Договор.Наименование = "С покупателем (создан обменом)";
	Договор.ВидДоговора  = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	Договор.Записать();
	
	Возврат Договор.Ссылка;
	
КонецФункции

Функция СтавкаНДСПоУмолчанию()
	
	// Цены сайта уже включают НДС — используем ставку "НДС в том числе".
	// Если цены на сайте без НДС, замена на Перечисления.СтавкиНДС.НДС20
	Возврат Перечисления.СтавкиНДС.НДС20_120;
	
КонецФункции

Функция ВДату(Строка_Дата, Строка_Время)
	
	ДЧ = СтрРазделить(Строка_Дата, "-");
	ВЧ = СтрРазделить(Строка_Время, ":");
	Возврат Дата(Число(ДЧ[0]), Число(ДЧ[1]), Число(ДЧ[2]),
		Число(ВЧ[0]), Число(ВЧ[1]), Число(ВЧ[2]));
	
КонецФункции

Процедура ЗаписатьВЖурнал(Событие, Данные, Успех) Экспорт
	
	Набор = РегистрыСведений.инт_ЖурналОбмена.СоздатьНаборЗаписей();
	Запись = Набор.Добавить();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ИдЗаписи = Строка(Новый УникальныйИдентификатор);
	Запись.Событие = Событие;
	Запись.Данные = Лев(Данные, 10000);
	Запись.Успех = Успех;
	Набор.Отбор.ИдЗаписи.Установить(Запись.ИдЗаписи);
	Набор.Записать();
	
КонецПроцедуры

