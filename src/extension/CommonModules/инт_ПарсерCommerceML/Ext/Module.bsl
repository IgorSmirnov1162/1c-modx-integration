Функция ПрочитатьЗаказы(XMLСтрока) Экспорт
	
	Заказы = Новый Массив;
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLСтрока);
	
	ТекущийЗаказ   = Неопределено;
	ТекущийТовар   = Неопределено;
	ТекущийЭлемент = "";
	ВКонтрагенте   = Ложь;
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ТекущийЭлемент = Чтение.Имя;
			
			Если Чтение.Имя = "Документ" Тогда
				
				ТекущийЗаказ = Новый Структура;
				ТекущийЗаказ.Вставить("Ид", "");
				ТекущийЗаказ.Вставить("Номер", "");
				ТекущийЗаказ.Вставить("Дата", "");
				ТекущийЗаказ.Вставить("Время", "");
				ТекущийЗаказ.Вставить("Валюта", "");
				ТекущийЗаказ.Вставить("СтатусЗаказа", "");
				ТекущийЗаказ.Вставить("Контрагент",
					Новый Структура("Ид,Наименование,Email,Телефон", "", "", "", ""));
				ТекущийЗаказ.Вставить("Товары", Новый Массив);
				ТекущийТовар = Неопределено;
				ВКонтрагенте = Ложь;
				
				Заказы.Добавить(ТекущийЗаказ);
				
			ИначеЕсли Чтение.Имя = "Контрагент" Тогда
				
				ВКонтрагенте = Истина;
				
			ИначеЕсли Чтение.Имя = "Товар" И ТекущийЗаказ <> Неопределено Тогда
				
				ТекущийТовар = Новый Структура(
					"Ид,Артикул,Наименование,БазоваяЕдиница,ЦенаЗаЕдиницу,Количество,Сумма",
					"", "", "", "", 0, 0, 0);
				ТекущийЗаказ.Товары.Добавить(ТекущийТовар);
				
			КонецЕсли;
			
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Если Чтение.Имя = "Товар" Тогда
				ТекущийТовар = Неопределено;
			ИначеЕсли Чтение.Имя = "Контрагент" Тогда
				ВКонтрагенте = Ложь;
			ИначеЕсли Чтение.Имя = "Документ" Тогда
				ТекущийЗаказ = Неопределено;
			КонецЕсли;
			
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			
			Значение = СокрЛП(Чтение.Значение);
			Если Значение = "" Или ТекущийЗаказ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекущийТовар <> Неопределено Тогда
				
				Если ТекущийЭлемент = "ЦенаЗаЕдиницу" Тогда
					ТекущийТовар.ЦенаЗаЕдиницу = ВЧисло(Значение);
				ИначеЕсли ТекущийЭлемент = "Количество" Тогда
					ТекущийТовар.Количество = ВЧисло(Значение);
				ИначеЕсли ТекущийЭлемент = "Сумма" Тогда
					ТекущийТовар.Сумма = ВЧисло(Значение);
				ИначеЕсли ТекущийТовар.Свойство(ТекущийЭлемент) Тогда
					ТекущийТовар[ТекущийЭлемент] = Значение;
				КонецЕсли;
				
			ИначеЕсли ВКонтрагенте Тогда
				
				Если ТекущийЗаказ.Контрагент.Свойство(ТекущийЭлемент) Тогда
					ТекущийЗаказ.Контрагент[ТекущийЭлемент] = Значение;
				КонецЕсли;
				
			ИначеЕсли ТекущийЗаказ.Свойство(ТекущийЭлемент) Тогда
				
				ТекущийЗаказ[ТекущийЭлемент] = Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Заказы;
	
КонецФункции

Функция ВЧисло(Значение)
	
	// CommerceML отдаёт числа с точкой, а Число() в русской локали ждёт запятую
	Возврат Число(СтрЗаменить(Значение, ".", ","));
	
КонецФункции
