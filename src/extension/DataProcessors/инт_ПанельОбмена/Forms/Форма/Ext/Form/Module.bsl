
&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	
	Если Настройка.Пустая() Тогда
		ПоказатьПредупреждение(, "Выберите запись настроек");
		Возврат;
	КонецЕсли;
	
	Результат = ВыполнитьОбменНаСервере();
	ПоказатьПредупреждение(, Результат);   
	
	ЗаполнитьЖурналНаСервере();
		
КонецПроцедуры

&НаСервере
Функция ВыполнитьОбменНаСервере()
	Возврат инт_ОбменССайтом.ВыполнитьЦиклОбмена(Настройка);
КонецФункции   

&НаСервере
Процедура ЗаполнитьЖурналНаСервере()     
	
	Журнал.Очистить(); // сбрасываем таблицу перед заполнением
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Журнал.Период КАК Период,
		|	Журнал.Событие КАК Событие,
		|	Журнал.Данные КАК Данные,
		|	Журнал.Успех КАК Успех
		|ИЗ
		|	РегистрСведений.инт_ЖурналОбмена КАК Журнал
		|УПОРЯДОЧИТЬ ПО
		|	Журнал.Период УБЫВ";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		НоваяСтрока = Журнал.Добавить();
		НоваяСтрока.Период  = Строка.Период;
		НоваяСтрока.Событие = Строка.Событие;
		НоваяСтрока.Данные  = Строка.Данные;
		НоваяСтрока.Успех   = Строка.Успех;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЖурналНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьЖурналНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	ОткрытьФорму("Справочник.инт_НастройкиОбмена.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурнал(Команда)
	ОткрытьФорму("РегистрСведений.инт_ЖурналОбмена.ФормаСписка");
КонецПроцедуры





